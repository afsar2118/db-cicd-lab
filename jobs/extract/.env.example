# Copy to jobs/extract/.env (git-ignored) and fill in. Values for the dev environment shown.
SRC_HOST=localhost
SRC_PORT=5432
SRC_DB=src_sf_dev
SRC_USER=postgres
SRC_PASSWORD=

LND_HOST=localhost
LND_PORT=5432
LND_DB=landing_dev
LND_USER=postgres
LND_PASSWORD=

# Optional: path to a local Postgres JDBC jar. Empty = Spark downloads org.postgresql:postgresql from Maven.
SPARK_JDBC_JAR=
